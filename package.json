{
  "name": "qingye-pdf",
  "version": "1.0.0",
  "description": "轻页 PDF 压缩 · 离线批量压缩工具",
  "author": "Qingye contributors",
  "license": "AGPL-3.0-or-later",
  "main": "src/main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "build:mac": "electron-builder --mac dmg --arm64 --publish never",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "test:ui": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "mupdf": "1.28.1"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "@playwright/test": "^1.58.0"
  },
  "build": {
    "appId": "local.qingye.pdfcompressor",
    "productName": "轻页 PDF 压缩",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "package.json",
      "assets/icon.ico",
      "assets/icon.icns"
    ],
    "asarUnpack": [
      "node_modules/mupdf/dist/*.wasm"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "artifactName": "Qingye-PDF-${version}-mac-arm64.${ext}",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "artifactName": "Qingye-PDF-${version}-win-x64-setup.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "轻页 PDF 压缩"
    }
  }
}
