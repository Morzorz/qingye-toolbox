{
  "name": "qingye-pdf",
  "version": "1.1.1",
  "description": "轻页文件工具箱 · 本地转换与 AI 调用",
  "author": "Qingye contributors",
  "license": "AGPL-3.0-or-later",
  "main": "src/entry.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:docker": "node --test docker/tests/smoke.test.mjs",
    "test:fnos": "node --test fnos/tests/server.test.mjs",
    "test:fnos:ui": "node fnos/tests/browser.mjs",
    "build:mac": "electron-builder --mac dmg --arm64 --publish never",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "test:ui": "node scripts/toolbox-smoke.mjs",
    "mcp": "node scripts/mcp-server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@trimjs/web-app": "0.5.0",
    "mupdf": "1.28.1",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "local.qingye.pdfcompressor",
    "productName": "轻页文件工具箱",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "package.json",
      "assets/icon.ico",
      "assets/icon.icns",
      "assets/fonts/**/*"
    ],
    "asarUnpack": [
      "node_modules/mupdf/dist/*.wasm",
      "node_modules/@img/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "artifactName": "Qingye-Toolbox-${version}-mac-arm64.${ext}",
      "icon": "assets/icon.icns",
      "files": [
        "src/**/*",
        "assets/icon.png",
        "LICENSE",
        "THIRD-PARTY-NOTICES.md",
        "package.json",
        "assets/icon.ico",
        "assets/icon.icns",
        "!node_modules/@img/sharp-win32-x64/**/*",
        "!node_modules/@img/sharp-wasm32/**/*",
        "assets/fonts/**/*"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "artifactName": "Qingye-Toolbox-${version}-win-x64-setup.${ext}",
      "icon": "assets/icon.ico",
      "files": [
        "src/**/*",
        "assets/icon.png",
        "LICENSE",
        "THIRD-PARTY-NOTICES.md",
        "package.json",
        "assets/icon.ico",
        "assets/icon.icns",
        "!node_modules/@img/sharp-darwin-arm64/**/*",
        "!node_modules/@img/sharp-libvips-darwin-arm64/**/*",
        "!node_modules/@img/sharp-wasm32/**/*",
        "assets/fonts/**/*"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "轻页文件工具箱"
    }
  }
}
